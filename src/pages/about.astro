---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../../site.config.json';
---

<BaseLayout title="About" description={`Learn what ${site.name} offers and where to begin.`}>
  <section class="interior-hero shell">
    <p class="eyebrow">About the project</p>
    <h1>A clearer path from curiosity to understanding.</h1>
    <p class="lead">{site.description}</p>
  </section>
  <section class="prose shell" aria-label="Project overview">
    <h2>What belongs here</h2>
    <p>Tell visitors what you make, who it serves, and what they can do next. Keep the opening concrete, then link to deeper guides, articles, or examples as the site grows.</p>
    <h2>Where to begin</h2>
    <p>Choose one useful first step for a new reader. A short guide, a working example, or a concise explanation is usually enough.</p>
    <p><a href="/">Return to the home page</a></p>
  </section>
</BaseLayout>
